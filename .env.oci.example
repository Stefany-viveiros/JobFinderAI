# Copie para .env no servidor. Nunca versione o arquivo .env preenchido.
# O domínio precisa apontar por DNS para o IPv4 público da instância.
DOMAIN=jobfinder.seu-subdominio-gratuito.example

# Use inicialmente o Neon existente. Não coloque credenciais neste exemplo.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST/BASE?sslmode=require

# Mantenha fechado até a auditoria de titularidade, migrações e preflight de staging.
MULTITENANT_READY=false
DEMO_READ_ONLY=true

APP_ENV=production
AUTO_INIT_DB=false
COOKIE_SECURE=true
SESSION_HOURS=24
TIMEZONE=America/Sao_Paulo
APP_BASE_URL=https://jobfinder.seu-subdominio-gratuito.example
CORS_ORIGINS=https://jobfinder.seu-subdominio-gratuito.example
VITE_API_URL=/api

# IA (opcional até configurar no provedor Google).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gerar chaves Fernet distintas para cada finalidade:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_CREDENTIALS_KEY=
RESUME_STORAGE_KEY=

# SMTP fica desativado até a etapa final de configuração.
# Gmail da plataforma: use senha de app Google, nunca a senha normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=candidatura.jobfinder@gmail.com
SMTP_PASSWORD=
SMTP_FROM=candidatura.jobfinder@gmail.com
# Destinatário dos lembretes administrativos (deixe vazio até definir).
SMTP_TO=
SMTP_USE_TLS=true
SMTP_ALLOWED_HOSTS=
