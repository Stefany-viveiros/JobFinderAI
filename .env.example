# SMTP (opcional). Necessário para: lembretes de tarefas e envio de candidaturas por e-mail.
# Para ENVIAR CANDIDATURAS são obrigatórios: SMTP_HOST, SMTP_FROM, SMTP_USERNAME, SMTP_PASSWORD.
# Use uma "senha de app" do provedor; nunca a senha principal da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Destinatário dos lembretes de tarefas (não é usado nas candidaturas)
SMTP_TO=
SMTP_USE_TLS=true
# Fuso IANA usado no limite diário e no agendador (ex.: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo
# Opcional: caminho de um PDF do currículo para anexar nas candidaturas por e-mail.
# Mantenha o arquivo FORA da pasta do projeto (ex.: C:/Users/voce/Documents/curriculo.pdf).
CV_PATH=
# Opcional: usar outro arquivo de banco SQLite (padrão: data/jobfinder.db)
JOBFINDER_DB_PATH=

# Gemini (opcional na execução local; obrigatório no servidor para análise inteligente do currículo).
# Gere a chave no Google AI Studio e configure-a também no ambiente de hospedagem.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Chave Fernet para cifrar senhas SMTP individuais no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Configure como segredo no ambiente de hospedagem; nunca compartilhe nem versione a chave.
SMTP_CREDENTIALS_KEY=
# Hostnames SMTP extras permitidos para contas individuais (separados por vírgula).
# Provedores conhecidos já são permitidos; inclua aqui somente servidores confiáveis.
SMTP_ALLOWED_HOSTS=

# Banco PostgreSQL hospedado (opcional; sem isso, usa SQLite local).
# Use a URL do Neon como DATABASE_URL e mantenha sslmode=require.
DATABASE_URL=
# CORS: origens autorizadas, separadas por vírgula. Sem wildcard; HTTPS remoto e HTTP apenas localhost.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ative SOMENTE no ambiente público de demonstração para bloquear alterações.
DEMO_READ_ONLY=false
# URL base da API usada pelo frontend em build (ex.: https://sua-api.onrender.com/api).
VITE_API_URL=

# Segurança da sessão e liberação multiusuário.
# Mantenha MULTITENANT_READY=false até concluir testes de isolamento e validação do schema.
MULTITENANT_READY=false
# APP_ENV controla validações de configuração: development, test, staging ou production.
APP_ENV=development
# Em produção/staging com HTTPS, true é obrigatório. Em desenvolvimento HTTP local, use false.
COOKIE_SECURE=false
SESSION_HOURS=24
# URL pública do frontend usada nos links de recuperação de senha.
APP_BASE_URL=
